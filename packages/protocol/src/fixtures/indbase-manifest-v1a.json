{
  "agent_id": "indbase",
  "name": "indbase",
  "version": "0.1.0",
  "protocol_version": "0",
  "commands": [
    {
      "name": "indbase.doctor",
      "description": "Run integrity checks against an indbase vault.",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vault_path"],
        "properties": {
          "vault_path": { "type": "string" },
          "hard_only": { "type": "boolean", "default": false }
        }
      },
      "preview_policy": {
        "preview_kind": "static",
        "requires_approval_before_preview": false,
        "preview_side_effects": [],
        "invalidates_on_context_change": true
      },
      "side_effects": ["read_vault_files", "read_vault_database", "read_vault_config"],
      "permissions": [{ "kind": "read_files", "scope": "vault" }]
    },
    {
      "name": "indbase.ingest_file",
      "description": "Ingest a single local file into an indbase vault.",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vault_path", "source_path"],
        "properties": {
          "vault_path": { "type": "string" },
          "source_path": { "type": "string" }
        }
      },
      "preview_policy": {
        "preview_kind": "probe_readonly",
        "requires_approval_before_preview": true,
        "preview_side_effects": ["read_source_file", "read_vault_database"],
        "invalidates_on_context_change": true
      },
      "side_effects": [
        "read_source_file",
        "write_vault_database",
        "write_vault_files",
        "read_vault_config"
      ],
      "permissions": [
        { "kind": "read_files", "scope": "source" },
        { "kind": "write_database", "scope": "vault" }
      ]
    }
  ]
}
