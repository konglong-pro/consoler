{
  "agent_id": "indbase",
  "name": "indbase",
  "version": "0.1.0",
  "protocol_version": "0",
  "commands": [
    {
      "name": "indbase.doctor",
      "description": "Run integrity checks against an indbase vault.",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vault_path"],
        "properties": {
          "vault_path": {
            "type": "string",
            "description": "Path to an existing indbase vault."
          },
          "hard_only": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "preview_policy": {
        "preview_kind": "static",
        "requires_approval_before_preview": false,
        "preview_side_effects": [],
        "invalidates_on_context_change": true
      },
      "side_effects": [
        "read_vault_files",
        "read_vault_database",
        "read_vault_config"
      ],
      "permissions": [
        {
          "kind": "read_files",
          "scope": "vault",
          "description": "Read vault files during execution."
        },
        {
          "kind": "read_database",
          "scope": "vault",
          "description": "Read vault SQLite metadata during execution."
        }
      ]
    }
  ]
}
