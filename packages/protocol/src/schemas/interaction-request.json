{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://consoler.dev/schemas/v0/interaction-request.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["interaction_id", "title", "message"],
  "properties": {
    "interaction_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prompt_schema": {
      "type": "object",
      "description": "JSON Schema for object responses. Top-level properties may set x-consoler-redact: true to redact persisted trace values only."
    },
    "default_response": {},
    "blocks": {
      "type": "array",
      "items": { "$ref": "https://consoler.dev/schemas/v0/renderable-block.json" }
    },
    "timeout_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "on_timeout"],
      "properties": {
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "on_timeout": {
          "type": "string",
          "enum": ["abort", "use_default", "skip", "continue"]
        }
      }
    }
  }
}
