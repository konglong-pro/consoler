{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://consoler.dev/schemas/v0/manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "name", "version", "protocol_version", "commands"],
  "properties": {
    "agent_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "protocol_version": { "type": "string", "const": "0" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/command" }
    },
    "artifact_retrieval": { "$ref": "#/definitions/artifact_retrieval" }
  },
  "definitions": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "args_schema",
        "preview_policy",
        "side_effects",
        "permissions"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "args_schema": { "type": "object" },
        "preview_policy": { "$ref": "#/definitions/preview_policy" },
        "side_effects": {
          "type": "array",
          "items": { "type": "string" }
        },
        "permissions": {
          "type": "array",
          "items": { "$ref": "#/definitions/permission" }
        }
      }
    },
    "preview_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_kind",
        "requires_approval_before_preview",
        "preview_side_effects",
        "invalidates_on_context_change"
      ],
      "properties": {
        "preview_kind": {
          "type": "string",
          "enum": ["static", "dynamic", "probe_readonly"]
        },
        "requires_approval_before_preview": { "type": "boolean" },
        "preview_side_effects": {
          "type": "array",
          "items": { "type": "string" }
        },
        "invalidates_on_context_change": { "type": "boolean" }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "artifact_retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri_schemes", "kinds"],
      "properties": {
        "uri_schemes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
