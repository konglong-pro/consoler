{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://consoler.dev/schemas/v0/renderable-block.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["block_id", "type", "content"],
  "properties": {
    "block_id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["markdown", "table", "json", "error", "diff", "artifact"]
    },
    "title": { "type": "string" },
    "content": {}
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "markdown" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "content": { "type": "string" } }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "table" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["columns", "rows"],
            "properties": {
              "columns": {
                "type": "array",
                "items": { "type": "string" }
              },
              "rows": {
                "type": "array",
                "items": { "type": "array" }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "error" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "details": { "type": "object" },
              "retryable": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "diff" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unified_diff"],
            "properties": {
              "unified_diff": { "type": "string" },
              "language": { "type": "string" },
              "from_label": { "type": "string" },
              "to_label": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "artifact" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "kind"],
            "properties": {
              "uri": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "metadata": { "type": "object" }
            }
          }
        }
      }
    }
  ]
}
