{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://consoler.dev/schemas/v0/renderable-block.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["block_id", "type", "content"],
  "properties": {
    "block_id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["markdown", "table", "json", "error"]
    },
    "title": { "type": "string" },
    "content": {}
  }
}
