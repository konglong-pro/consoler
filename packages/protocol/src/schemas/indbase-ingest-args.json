{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://consoler.dev/schemas/v0/indbase-ingest-args.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["vault_path", "source_path"],
  "properties": {
    "vault_path": {
      "type": "string",
      "description": "Path to an existing indbase vault."
    },
    "source_path": {
      "type": "string",
      "description": "Path to a single local file to ingest."
    }
  }
}
