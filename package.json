{
  "name": "consoler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "agentctl": "pnpm --filter @consoler/agentctl start",
    "tui": "pnpm --filter @consoler/tui start",
    "tui:indbase": "pnpm --filter @consoler/tui start:indbase",
    "build": "pnpm -r build",
    "test": "pnpm -r --filter \"!@consoler/conformance\" test",
    "test:conformance": "node scripts/test-conformance.mjs",
    "test:agentctl-smoke": "node scripts/test-agentctl-smoke.mjs",
    "test:redaction-smoke": "node scripts/test-redaction-smoke.mjs",
    "test:v1-release-gate": "node scripts/test-v1-release-gate.mjs",
    "test:v2-release-gate": "node scripts/test-v2-release-gate.mjs",
    "test:v3b-intent-gate": "node scripts/test-v3b-intent-gate.mjs",
    "test:v3c-assisted-intent-gate": "node scripts/test-v3c-assisted-intent-gate.mjs",
    "test:v3c-tui-assisted-intent-gate": "node scripts/test-v3c-tui-assisted-intent-gate.mjs",
    "test:v4d-indbase-dogfood-ux": "node scripts/test-v4d-indbase-dogfood-ux.mjs",
    "test:v4e-indbase-variant-intent-drafting": "node scripts/test-v4e-indbase-variant-intent-drafting.mjs",
    "test:artifact-retrieval-smoke": "node scripts/test-artifact-retrieval-smoke.mjs",
    "test:real-indbase-smoke": "node scripts/test-real-indbase-smoke.mjs",
    "test:python-sdk": "node scripts/test-python-sdk.mjs",
    "test:python-sdk-package": "node scripts/test-python-sdk-package.mjs",
    "publish:python-sdk": "node scripts/publish-python-sdk.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
